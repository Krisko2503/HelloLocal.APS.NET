@model IEnumerable<HelloLocal.Web.Models.TourExperience>

@{
    ViewData["top_tab_title"] = "Available Tours";
}

<DIV style="background:#f4f4f4; padding: 25px; border-radius: 5px; margin-bottom:20px; border:1px solid #ddd;">
    <h2 class="main_tours_header_text" style="color: #c82a54; font-weight: bold;">ALL EXPERIENCES</h2>
    <p class="little_subtitle_for_tours">Check out what our locals have prepared for you. No boring stuff.</p>
    <a asp-action="Create" class="btn btn-warning create_new_tour_btn" style="font-weight:900">+ Add New Experience</a>
</DIV>

    <form asp-controller="TourExperiences" asp-action="Index" method="get" style="background:#e9ecef; padding:15px; border-radius:4px; margin-bottom:25px; border-left:4px solid #c82a54;">
    <span class="filter_label_text" style="font-weight:bold; margin-right:15px;">Find Experience:</span>

    <input type="text" name="search_word" placeholder="Type a keyword..." style="padding:6px; width:180px; border:1px solid #aaa;" />

    <span style="margin-left:15px; margin-right:5px;">Max Price:</span>
    <input type="number" name="max_money" placeholder="$" style="padding:6px; width:90px; border:1px solid #aaa;" />

    <button type="submit" class="btn btn-dark submit_search_btn" style="margin-left:15px; font-weight:bold;">Search</button>
    <a asp-action="Index" class="btn btn-link clear_filters_btn" style="color:#555;">Clear</a>
    </form>

<div class="container wrapper_for_tours_list">
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4" style="margin-bottom: 20px;">
                <DIV class="single_tour_card_item" style="border:2px solid #ccc; padding: 15px; background: white; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);">

                    <h3 class="tour_title_heading" style="font-size:20px; color:#111">@item.Title</h3>
                    <h4 class="price_tag_green" style="color: green; font-weight:bold;">$@item.Price</h4>

                    <p class="tour_desc_paragraph" style="color:#666; margin-top:10px; min-height:60px;">@item.Description</p>

                    <br>
                    <div class="buttons_container_bottom" style="background:#eee; padding:8px; text-align:center;">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary the_edit_btn">Edit</a>
                        &nbsp;
                        <A asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary the_details_btn">View</A>
                        &nbsp;
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger the_delete_btn">Drop</a>
                    </div>

                </DIV>
            </div>
        }

    </div>
</div>
<br><br>