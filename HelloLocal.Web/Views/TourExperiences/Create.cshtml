@model HelloLocal.Web.Models.TourExperience

@{
    ViewData["Title"] = "Add New Experience";
}

<h2 style="color: #c82a54; font-weight: 800;">Add New Experience</h2>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label" style="font-weight: bold;"></label>
                <input asp-for="Title" class="form-control" />
                <small class="text-muted">Enter a captivating title for the tour.</small>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label" style="font-weight: bold;"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <small class="text-muted">Final price for the tour (e.g., 150.00).</small>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="control-label" style="font-weight: bold;"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <small class="text-muted">Describe in detail what the tourists will do and what is included.</small>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-4">
                <label asp-for="LocalGuideId" class="control-label" style="font-weight: bold;">Guide</label>
                <select asp-for="LocalGuideId" class="form-control" asp-items="ViewBag.LocalGuides">
                    <option value="">-- Choose a guide --</option>
                </select>
                <small class="text-muted">Izberete gid za tova prejivqvane.</small>
                <span asp-validation-for="LocalGuideId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create Experience" class="btn btn-primary" style="background-color: #10b981; border: none; font-weight: bold;" />
                <a asp-action="Index" class="btn btn-link" style="color: #c82a54; text-decoration: none; font-weight: bold;">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}