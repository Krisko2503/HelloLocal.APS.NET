<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["tab_title_name"] - Hello Local</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<BODY style="background-color:#fcfcfc;" class="d-flex flex-column min-vh-100" >

    <header>
        <NAV class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow" style='margin-bottom: 20px;'>
            <div class="container-fluid top_nav_main_container">
                <a class="navbar-brand the_logo_text_brand" asp-area="" asp-controller="Home" asp-action="Index" style="font-weight:900;color:#c82a54;">HelloLocal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 main_ul_list_for_links">

                        <li class='nav-item'>
                            <a class="nav-link text-dark the_home_link_btn" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <A asp-action="Index" asp-area="" asp-controller="LocalGuides" class="nav-link text-dark find_guide_link">Our Guides</A>
                        </li>
                        <li class="nav-item"><a class="nav-link text-dark tours_link_item" asp-area="" asp-controller="TourExperiences" asp-action="Index">Experiences</a></li>
                        <li class="nav-item">
                            <a class="nav-link text-dark booking_link_nav" asp-area="" asp-controller="Bookings" asp-action="Index">Bookings</a>
                        </li>

                    </ul>
                    <ul class="navbar-nav">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </NAV>
    </header>

    <div class="container main_content_wrapper_div">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   
    <footer class="mt-auto" style="background-color: #f4f4f4; border-top: 2px solid #ddd; padding: 15px 0; text-align: center;">
        <div class="container">
            <h5 style="color: #c82a54; font-weight: 800; margin-bottom: 2px;">HELLO LOCAL</h5>
            <div style="font-size: 13px; color: #777;">
                &copy; @DateTime.Now.Year - Hello Local |
                <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: #10b981; font-weight: bold; text-decoration: none;">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</BODY>
</html>