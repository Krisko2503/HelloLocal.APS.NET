@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav d-flex align-items-center flex-row" style="list-style: none; padding-left: 0; margin-bottom: 0;">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item" style="margin-right: 15px;">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" style="color: #555; font-weight: bold; text-decoration: none;">Hello, @User.Identity?.Name!</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-sm btn-danger" style="font-weight: bold; border-radius: 5px;">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item" style="margin-right: 10px;">
            <a class="btn btn-sm btn-outline-dark" asp-area="Identity" asp-page="/Account/Register" style="font-weight: bold; border-radius: 5px;">Register</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-success" asp-area="Identity" asp-page="/Account/Login" style="background-color: #10b981; border: none; font-weight: bold; border-radius: 5px;">Login</a>
        </li>
    }
</ul>