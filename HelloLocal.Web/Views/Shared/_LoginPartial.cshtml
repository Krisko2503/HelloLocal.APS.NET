@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> _signInMgr
@inject UserManager<IdentityUser> _usrMgr

@if (_signInMgr.IsSignedIn(User))
{
    <li class='nav-item'>
        <a class='nav-link text-dark' asp-area='Identity' asp-page='/Account/Manage/Index' title='Manage'>
            Hello @User.Identity?.Name!
        </a>
    </li>
    <li class='nav-item'>
        <form id='logoutForm' asp-area='Identity' asp-page='/Account/Logout' asp-route-returnUrl='@Url.Action("Index", "Home", new { area = "" })'>
            <button type='submit' class='nav-link btn btn-link text-dark' style='border:0px; background-color:transparent;'>
                Logout
            </button>
        </form>
    </li>
}
else
{
    <li class='nav-item' style='margin-right: 5px;'>
        <a class='nav-link text-dark' asp-area='Identity' asp-page='/Account/Register'>Register</a>
    </li>
    <li class='nav-item'>
        <a class='nav-link text-dark' asp-area='Identity' asp-page='/Account/Login'>Login</a>
    </li>
}