@model IEnumerable<HelloLocal.Web.Models.Booking>

@{
    ViewData["Title"] = "Index";
}

<h1>Bookings</h1>
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TouristName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookingDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TourExperienceId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Experience)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TouristName)
            </td>
            <td>
                @Html.DisplayFor(model => item.BookingDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.TourExperienceId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Experience.Title)
            </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" style="color: #10b981; font-weight: bold; text-decoration: none; margin-right: 10px;">Details</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" style="color: #f59e0b; font-weight: bold; text-decoration: none; margin-right: 10px;">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" style="color: #c82a54; font-weight: bold; text-decoration: none;">Delete</a>
                    }
                </td>
        </tr>
}
    </tbody>
</table>
