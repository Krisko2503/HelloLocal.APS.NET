@model HelloLocal.Web.Models.Booking


<h1>Create</h1>
<h4>Booking</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="TouristName" class="control-label" style="font-weight: bold;"></label>
                <input asp-for="TouristName" class="form-control" />
                <small class="text-muted">Enter your name and surname.</small>
                <span asp-validation-for="TouristName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingDate" class="control-label" style="font-weight: bold;"></label>
                <input asp-for="BookingDate" class="form-control" type="datetime-local" />
                <small class="text-muted">Choose the desired date and time for the booking.</small>
                <span asp-validation-for="BookingDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="TourExperienceId" class="control-label" style="font-weight: bold;">Experience</label>
                <select asp-for="TourExperienceId" class="form-control" asp-items="ViewBag.Experiences">
                    <option value="">-- Choose an experience --</option>
                </select>
                <small class="text-muted">Choose the experience you would like to book.</small>
                <span asp-validation-for="TourExperienceId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" style="background-color: #10b981; border: none; font-weight: bold;" />
                <a asp-action="Index" class="btn btn-link" style="color: #c82a54;">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}