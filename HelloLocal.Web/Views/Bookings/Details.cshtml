@model HelloLocal.Web.Models.Booking

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Booking</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TouristName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TouristName)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BookingDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BookingDate)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TourExperienceId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TourExperienceId)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Experience)
        </dt>
        <dd class = "col-sm-10">
            @Model.Experience.Title - @Model.Experience.Description
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning" style="font-weight: bold;">Edit</a>
        <span>|</span>
    }
    <a asp-action="Index" style="color: #c82a54; font-weight: bold; text-decoration: none;">Back to List</a>
</div>