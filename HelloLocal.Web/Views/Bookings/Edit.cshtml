@model HelloLocal.Web.Models.Booking


<h2 style="color: #c82a54; font-weight: 800;">Edit Booking</h2>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

         
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="TouristName" class="control-label" style="font-weight: bold;"></label>
                <input asp-for="TouristName" class="form-control" />
                <small class="text-muted">Change the tourist's name if necessary.</small>
                <span asp-validation-for="TouristName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingDate" class="control-label" style="font-weight: bold;"></label>
                <input asp-for="BookingDate" class="form-control" type="datetime-local" />
                <small class="text-muted">Change the booking date and time if necessary.</small>
                <span asp-validation-for="BookingDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="TourExperienceId" class="control-label" style="font-weight: bold;">Experience</label>
                <select asp-for="TourExperienceId" class="form-control" asp-items="ViewBag.Experiences">
                    <option value="">-- Choose an experience --</option>
                </select>
                <span asp-validation-for="TourExperienceId" class="text-danger"></span>
            </div>

            <div class="form-group">
                
                <input type="submit" value="Save Changes" class="btn btn-primary" style="background-color: #f59e0b; border: none; font-weight: bold; color: white;" />
                <a asp-action="Index" class="btn btn-link" style="color: #c82a54; text-decoration: none; font-weight: bold;">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}