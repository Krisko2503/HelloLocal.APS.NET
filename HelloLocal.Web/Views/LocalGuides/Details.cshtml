@model HelloLocal.Web.Models.LocalGuide

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>LocalGuide</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Bio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Bio)
        </dd>
    </dl>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.HourlyRate)
        </dt>
        <dd class="col-sm-10">
            @Model.HourlyRate.ToString("0")
        </dd>
        <dt class="col-sm-2">
            Experiences
        </dt>
        <dd class="col-sm-10">
            @if (Model.Experiences != null && Model.Experiences.Any())
            {
                <ul>
                    @foreach (var exp in Model.Experiences)
                    {
                        <li>@exp.Title - $@exp.Price.ToString("0.00")</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">This guide doesn't have any experiences yet.</span>
            }
        </dd>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
