@page
@model LoginModel
@{
    ViewData["Title"] = "Welcome Back";
}

<style>
    .hello-input { border-radius: 8px; transition: all 0.3s ease; }
    .hello-input:focus { border-color: #c82a54; box-shadow: 0 0 0 4px rgba(200, 42, 84, 0.15); outline: none; }
    .hello-btn { background: #c82a54; color: #fff; border: none; border-radius: 8px; font-weight: 800; font-size: 18px; padding: 14px; transition: all 0.3s; }
    .hello-btn:hover { background: #a82045; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(200, 42, 84, 0.3); color: #fff; }
</style>

<div class="container" style="margin-top: 60px; margin-bottom: 60px;">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h2 style="color: #222; font-weight: 900; font-size: 32px; text-align: center; margin-bottom: 8px;">Log in to <span style="color: #c82a54;">Hello Local</span></h2>
            <p style="text-align: center; color: #777; margin-bottom: 35px; font-size: 16px;">Enter your details to access your account.</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                
                <div class="form-floating mb-4">
                    <input asp-for="Input.Email" class="form-control hello-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" style="color: #555;">Email Address</label>
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 13px; font-weight: bold;"></span>
                </div>
                
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control hello-input" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" style="color: #555;">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 13px; font-weight: bold;"></span>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                    <label asp-for="Input.RememberMe" class="form-label" style="color: #555; font-weight: 600; cursor: pointer; margin: 0;">
                        <input class="form-check-input" asp-for="Input.RememberMe" style="accent-color: #c82a54; width: 18px; height: 18px; margin-right: 8px; cursor: pointer;" />
                        Remember me
                    </label>
                    <a id="forgot-password" asp-page="./ForgotPassword" style="color: #c82a54; font-weight: 600; text-decoration: none; font-size: 14px;">Forgot password?</a>
                </div>
                
                <button id="login-submit" type="submit" class="w-100 hello-btn mb-4">Log In</button>
            </form>
            
            <div style="text-align: center; font-size: 15px; border-top: 2px dashed #eee; padding-top: 20px;">
                <span style="color: #777;">Don't have an account?</span> 
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" style="color: #c82a54; text-decoration: none; font-weight: 800;">Sign up</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}